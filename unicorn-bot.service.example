[Unit]
Description=Unicorn Hunt Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/unicorn_bot
ExecStart=/home/ubuntu/unicorn_bot/.venv/bin/python /home/ubuntu/unicorn_bot/bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
